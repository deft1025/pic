# 小小绘本馆：API、dbinit、importer 自动读取项目根目录 .env。
# 优先级：命令行路径参数 > 环境变量 > 本文件 > 程序默认值。
# 密码含 #、$、空格时请用单引号包裹，避免插值。
HTTP_ADDR=127.0.0.1:8198
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pic
DB_USER=pic
DB_PASSWORD=''
DB_TLS=false
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=10s
DB_WRITE_TIMEOUT=15s
DB_CONN_MAX_LIFETIME=3m
DB_CONN_MAX_IDLE_TIME=1m

CONTENT_DIR=content/books
WEB_DIR=web
# 留空使用本地素材；独立域名示例 https://media.example.com（目录下保留 assets/）。
ASSET_BASE_URL=
# auto：优先校验本地，缺失时校验素材域名；local：只本地；remote：全部检查域名。
ASSET_CHECK_MODE=auto
ASSET_CHECK_TIMEOUT=10s
ASSET_CHECK_CONCURRENCY=6
SCHEMA_FILE=docs/schema.sql
# 初期不启用授权审核门槛。
REQUIRE_LICENSE_APPROVAL=false

# Docker Compose 专用，Go 应用不读取此项。
MYSQL_ROOT_PASSWORD=''
