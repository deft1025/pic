.tab-bar{position:fixed;z-index:9;left:0;right:0;bottom:0;padding:6px 8px calc(6px + env(safe-area-inset-bottom));background:#fffdf7;border-top:1px solid #e4edf0;box-sizing:border-box}
.tab-items{display:flex;align-items:center;gap:8px;max-width:600px;margin:0 auto}
.tab-item{box-sizing:border-box;flex:1;min-width:0;max-width:180px;height:64px;margin:0 auto;padding:7px 4px 5px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:0;border-radius:20px;background:transparent;color:#6b828c;line-height:1.3}
.tab-item::after{border:0}.tab-item.selected{background:#e6f3fa;color:#245c78}.tab-pressed{background:#f0f6f8}
.tab-label{font-size:16px;font-weight:500;letter-spacing:.5px;white-space:nowrap}.selected .tab-label{font-weight:700}
.tab-icon{position:relative;box-sizing:border-box;width:26px;height:25px;flex-shrink:0;color:inherit}.icon-part{position:absolute;box-sizing:border-box}
.icon-discover{width:24px;height:24px;border:2px solid currentColor;border-radius:50%}.icon-discover .part-one{width:8px;height:13px;left:6px;top:3px;border:2px solid currentColor;border-radius:7px 7px 3px 3px;transform:rotate(38deg)}.selected .icon-discover .part-one{background:#badce9}.icon-discover .part-two{width:3px;height:3px;left:8.5px;top:8.5px;background:currentColor;border-radius:50%}
.icon-library .part-one,.icon-library .part-two{top:3px;width:13px;height:19px;border:2px solid currentColor;background:transparent}.icon-library .part-one{left:1px;border-radius:5px 1px 1px 3px;transform:skewY(8deg)}.icon-library .part-two{right:0;border-radius:1px 5px 3px 1px;transform:skewY(-8deg)}.selected .icon-library .icon-part{background:#cce6ef}
.icon-shelf .part-one{left:2px;top:3px;width:7px;height:18px;border:2px solid currentColor;border-radius:2px}.icon-shelf .part-two{left:10px;top:3px;width:7px;height:18px;border:2px solid currentColor;border-radius:2px;transform:rotate(-12deg);transform-origin:50% 100%}.icon-shelf .part-three{left:0;right:0;bottom:1px;height:2px;border-radius:2px;background:currentColor}.selected .icon-shelf .part-one,.selected .icon-shelf .part-two{background:#cce6ef}
