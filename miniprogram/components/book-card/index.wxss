.card{background:#fffdf7;border-radius:28rpx;padding:16rpx;height:100%;box-sizing:border-box}.cover{width:100%;height:250rpx;border-radius:18rpx;background:#eef5f7}.name{font-size:17px;font-weight:600;margin-top:14rpx;line-height:1.5}.reason{font-size:14px;color:#617e89;margin-top:8rpx;line-height:1.6}.meta{font-size:12px;color:#80939b;margin-top:12rpx}
.cover-wrap{position:relative}.completion{position:absolute;right:8rpx;bottom:12rpx;padding:4rpx 12rpx;border-radius:18rpx;background:#e5f4e9;color:#34764c;font-size:12px;font-weight:600;line-height:1.5}
