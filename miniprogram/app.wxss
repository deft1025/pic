page{background:#f8fbfc;color:#264652;font-size:16px;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;line-height:1.6}view,text,button,input,scroll-view{box-sizing:border-box}button{font-size:16px;border-radius:28rpx;background:#eaf4fa;color:#285970;padding:16rpx 26rpx;line-height:1.5;margin:0}button::after{border:0}button[disabled]{opacity:.5}button.primary{background:#ffda6e;color:#4c431d}button.small{font-size:14px;padding:12rpx 22rpx}.page{padding:30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom))}.hero{padding:40rpx 30rpx;border-radius:36rpx;background:#e7f4fc}.eyebrow{font-size:14px;color:#527f96;letter-spacing:3rpx}.title{font-size:28px;font-weight:700;line-height:1.35;margin:16rpx 0}.subtitle,.muted{color:#657c86}.section{font-size:21px;font-weight:700;margin:42rpx 0 24rpx}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.actions{display:flex;gap:16rpx;margin:26rpx 0}.actions>button{flex:1}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.panel{background:#fffdf7;border-radius:30rpx;padding:28rpx;margin:24rpx 0}.error{color:#934b34;background:#fff4e9;border-radius:24rpx;padding:24rpx;margin:22rpx 0}.empty{text-align:center;color:#657c86;padding:55rpx 20rpx}.search{background:#fff;border:2rpx solid #d5e7ef;border-radius:24rpx;padding:0 24rpx;height:88rpx;line-height:normal;font-size:16px;flex:1;min-width:0}.chips{white-space:nowrap;margin:20rpx 0}.chip{display:inline-block;padding:12rpx 24rpx;margin-right:14rpx;border-radius:30rpx;background:#eaf3f7;font-size:15px}.chip.active{background:#ffdf87;color:#51451d}.link{color:#2c6b8c}.copy{white-space:pre-wrap;overflow-wrap:anywhere}.note{font-size:14px;color:#657c86}image{background:#edf4f6}

.account-heading{display:flex;align-items:center;gap:14px;min-width:0}.account-copy{flex:1;min-width:0}.account-avatar-wrap{width:62px;height:62px;flex-shrink:0;border-radius:50%;overflow:hidden;background:#fffdf4;border:3px solid #fff;display:flex;align-items:center;justify-content:center}.account-avatar{width:100%;height:100%;background:transparent}.account-avatar-fallback{font-size:28px;line-height:1}.account-name{font-size:22px;font-weight:700;line-height:1.4;color:#304f5c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
