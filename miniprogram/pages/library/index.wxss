.filters{display:flex;gap:20rpx;margin:28rpx 0}.filter{flex:1;min-width:0}.filter-label{font-size:14px;color:#657c86;margin:0 8rpx 10rpx}.filter-value{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:88rpx;padding:18rpx 24rpx;background:#eaf4fa;border:2rpx solid #d5e7ef;border-radius:24rpx;color:#285970;font-size:16px}.filter-value>text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.filter-arrow{flex-shrink:0;color:#527f96}

.search-placeholder{color:#8b9da5;font-size:14px;line-height:normal}
