<view class="page"><view class="title">故事，慢慢挑</view><view class="row"><input class="search" value="{{q}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="书名、动物或一个小心情"/><button class="primary" bindtap="search">搜索</button></view><view class="filters"><view class="filter"><view class="filter-label">年龄段</view><picker mode="selector" range="{{ages}}" range-key="name" value="{{ageIndex}}" disabled="{{!filtersReady || filtersLoading}}" bindchange="age"><view class="filter-value"><text>{{ages[ageIndex].name}}</text><text class="filter-arrow">▾</text></view></picker></view><view class="filter"><view class="filter-label">主题</view><picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" disabled="{{!filtersReady || filtersLoading}}" bindchange="category"><view class="filter-value"><text>{{categories[categoryIndex].name}}</text><text class="filter-arrow">▾</text></view></picker></view></view><view wx:if="{{filtersLoading}}" class="note">正在加载筛选选项…</view><view wx:if="{{filterError}}" class="error">{{filterError}}<button class="small" bindtap="loadFilters">重试筛选</button></view><view class="note">共{{total}}本双语绘本</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="search">重新加载</button></view><view class="grid"><book-card wx:for="{{items}}" wx:key="id" book="{{item}}"/></view><view wx:if="{{loading}}" class="empty">正在找故事…</view><view wx:elif="{{!items.length && !error}}" class="empty">换个词或主题，再找找吧。</view><button wx:if="{{items.length < total && !loading}}" bindtap="more">再看一些</button></view>