.section{font-size:18px;margin:20rpx 0}
.name-field,.age-picker{display:flex;align-items:center;min-height:88rpx;padding:18rpx 24rpx;border-radius:24rpx;font-size:16px}
.name-field{background:#fff;border:2rpx solid #d5e7ef}
/* Native input centers its own text; keep vertical padding on the outer field. */
.name-input{width:100%;min-width:0;height:24px;line-height:24px;padding:0;border:0;font-size:16px;color:#264652;background:transparent}
.age-picker{background:#edf5f9;margin-bottom:14rpx}
