.profile-page{max-width:650px;margin:auto}.profile-intro{padding:20px 4px 28px}.profile-kicker{font-size:12px;color:#7c949e;margin-bottom:4px;letter-spacing:1px}.profile-caption{font-size:13px;color:#7c949e;line-height:1.6;margin-top:4px}.profile-form{padding:24px 20px;background:#fffdf7;border:1px solid #eeeadd;border-radius:26px}.field-label{display:flex;align-items:center;gap:10px;font-size:15px;color:#355563;font-weight:600;margin-bottom:12px}.field-optional{font-size:12px;font-weight:400;color:#9aa8aa}.age-label{margin-top:28px}.name-field,.age-picker{display:flex;align-items:center;min-height:48px;padding:12px 14px;border-radius:14px;font-size:16px}.name-field{background:#fff;border:1px solid #dbe8ec}.name-input{width:100%;min-width:0;height:24px;line-height:24px;padding:0;border:0;font-size:16px;color:#264652;background:transparent}.name-placeholder{color:#a2afb3;font-size:15px}.age-picker{background:#edf5f9;justify-content:space-between;gap:12px;color:#365c6c}.picker-arrow{color:#819ba6;font-size:20px}.field-note{font-size:12px;line-height:1.7;color:#8a9b9e;margin-top:12px}.profile-save{width:100%;min-height:50px;padding:13px 20px;margin-top:24px;font-size:16px;border-radius:16px}
