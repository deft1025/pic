<view class="page"><view class="hero"><view class="title">{{first ? '一起认识一下吧' : '我的阅读资料'}}</view><view class="subtitle">请选择适合孩子的阅读年龄段。</view></view><view wx:if="{{loading}}" class="empty">正在加载资料…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><view class="panel"><view class="section">怎么称呼你</view><view class="name-field"><input class="name-input" value="{{name}}" bindinput="name" maxlength="50" placeholder="小小读者（可不填）" aria-label="怎么称呼你"/></view><view class="section">阅读年龄段</view><picker mode="selector" range="{{ageNames}}" value="{{ageIndex}}" bindchange="age"><view class="age-picker">{{ageNames[ageIndex]}} ▾</view></picker><view class="note">年龄段之后也可以修改，不需要填写生日。</view></view><button class="primary" loading="{{saving}}" disabled="{{loading || saving || !age}}" bindtap="save">{{first ? '选好啦，保存资料' : '保存修改'}}</button></view>
