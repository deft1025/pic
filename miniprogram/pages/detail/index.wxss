.detail-page{max-width:760px;margin:0 auto}
.detail-cover{display:block;width:100%;height:500rpx;max-height:440px;border-radius:24px;background:#eaf3f6}
.detail-heading{margin:24px 0 20px}.detail-title{font-size:27px;font-weight:700;line-height:1.4;letter-spacing:.4px;color:#294957;overflow-wrap:anywhere}
.detail-original{margin-top:6px;font-size:14px;line-height:1.6;color:#81929a;overflow-wrap:anywhere}
.detail-facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.detail-fact{padding:3px 10px;border-radius:10px;background:#edf5f8;font-size:12px;line-height:1.6;color:#647f8c;white-space:nowrap}
.reading-value{padding:14px 16px;border-radius:18px;background:#fff8e6;border:1px solid #f4eacc}
.reading-value-label{font-size:12px;line-height:1.5;color:#9b8349;letter-spacing:1px;margin-bottom:5px}.reading-value-copy{font-size:16px;font-weight:600;line-height:1.75;color:#655b3b;overflow-wrap:anywhere}
.detail-description{margin:18px 2px 22px;font-size:15px;line-height:1.9;color:#667e89}
.detail-actions{margin:0 0 24px;gap:12px}.detail-actions>button{min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;padding:12px 8px;font-size:16px;border-radius:18px}
.detail-credits{padding:16px 2px 0;border-top:1px solid #e4edf0;color:#657f8b;font-size:13px;line-height:1.8}.detail-credits>view{display:flex;gap:14px;margin-bottom:4px}.credit-label{flex-shrink:0;color:#93a1a7}.credit-name{min-width:0;overflow-wrap:anywhere}
