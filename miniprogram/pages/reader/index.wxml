<view style="padding-top:{{safeTop + 8}}px" class="reader {{night ? 'night' : ''}} {{fullscreen ? 'expanded' : ''}}"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{page}}"><view wx:if="{{!fullscreen}}" class="reader-header"><button class="small" bindtap="back">‹ 返回</button><view>{{book.title_zh}}</view></view><view class="tools"><button class="small {{language === 'zh' ? 'primary' : ''}}" data-language="zh" bindtap="language">中文</button><button class="small {{language === 'en' ? 'primary' : ''}}" data-language="en" bindtap="language">English</button><button class="small" bindtap="text">{{showText ? '隐藏文字' : '显示文字'}}</button><button class="small" bindtap="night">{{night ? '日间' : '夜间'}}</button><button class="small" bindtap="fullscreen">{{fullscreen ? '收起' : '全屏'}}</button></view><view class="frame" style="height:{{frameHeight}}px"><image wx:if="{{!imageError}}" class="art" data-src="{{page.image}}" src="{{page.image}}" mode="aspectFit" bindload="imageLoaded" binderror="imageFailed" aria-label="{{page.image_alt}}"/><view wx:if="{{imageError}}" class="image-error">插画加载失败<button class="small" bindtap="retryImage">重试插画</button></view><view wx:if="{{showText && !imageError && imageReady}}" class="overlay {{bubbleReady ? 'ready' : ''}}" style="{{overlayStyle}}"><view class="measurements" aria-hidden="true"><view wx:for="{{measurements}}" wx:key="key" class="bubble-measure" style="width:{{item.width}}px"><view class="speaker"><text class="measure-speaker">{{item.speaker}}</text></view><view class="bubble-text"><text class="words measure-words">{{item.words}}</text></view></view></view><scroll-view class="speech-scroll" scroll-y="{{overflow}}"><block wx:for="{{bubbles}}" wx:key="key"><view wx:if="{{item.tailStyle && !overflow}}" class="tail" style="{{item.tailStyle}}"/><view class="bubble" style="{{item.style}}"><view class="speaker">{{item.speaker}}</view><scroll-view class="bubble-text" scroll-y="{{item.scroll}}" style="{{item.scrollStyle}}"><text class="words">{{item.words}}</text></scroll-view></view></block></scroll-view></view></view><view wx:if="{{showText && narration}}" class="narration copy">{{narration}}</view><view class="player"><view class="player-row"><button disabled="{{index === 0}}" bindtap="previous">上一页</button><button class="primary" bindtap="play">{{playing ? '暂停' : (audioError ? '重试播放' : '播放配音')}}</button><button disabled="{{index === total - 1}}" bindtap="next">下一页</button></view><view class="player-row"><picker mode="selector" range="{{pageNames}}" value="{{index}}" bindchange="pickPage"><view class="picker">第{{index + 1}} / {{total}}页 ▾</view></picker><button class="small" bindtap="auto">{{auto ? '连续播放：开' : '连续播放：关'}}</button><picker mode="selector" range="{{rates}}" value="{{rate === 1 ? 1 : (rate === 0.75 ? 0 : 2)}}" bindchange="rate"><view class="picker">{{rate}}倍 ▾</view></picker></view></view><view wx:if="{{audioError}}" class="error">{{audioError}}</view><button wx:if="{{index === total - 1 && !completed}}" class="primary finish" bindtap="finish">我们读完啦</button><view wx:if="{{completed}}" class="panel"><view class="section">又读完一个好故事！</view><view class="actions"><button class="primary" bindtap="again">再读一次</button><button bindtap="shelf">返回书架</button></view></view></block></view>