<view style="padding-top:{{safeTop}}px;{{fullscreen ? 'height:' + viewportHeight + 'px;padding-bottom:' + safeBottom + 'px;' : ''}}" class="reader {{fullscreen ? 'expanded' : ''}}">
 <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
 <block wx:if="{{page}}">
  <view wx:if="{{!fullscreen}}" class="reader-header"><button class="small" bindtap="back">‹ 返回</button><view>{{book.title_zh}}</view></view>
  <view wx:if="{{!fullscreen}}" class="tools">
   <view class="languages"><button class="small {{language === 'zh' ? 'primary' : ''}}" data-language="zh" bindtap="language">中文</button><button class="small {{language === 'en' ? 'primary' : ''}}" data-language="en" bindtap="language">English</button></view>
   <button class="small" bindtap="fullscreen">全屏阅读</button>
  </view>
  <view wx:if="{{fullscreen}}" class="fullscreen-header"><button class="small" bindtap="fullscreen">退出全屏</button><button wx:if="{{index === total - 1 && controlsVisible}}" class="small" bindtap="finish">读完啦</button><button wx:if="{{controlsVisible}}" class="small" bindtap="toggleLanguage">{{language === 'zh' ? '中文 ⇄ English' : 'English ⇄ 中文'}}</button></view>
  <view class="frame" style="height:{{frameHeight}}px" bindtap="controls">
   <image wx:if="{{!imageError}}" class="art" data-src="{{page.image}}" src="{{page.image}}" mode="aspectFit" bindload="imageLoaded" binderror="imageFailed" aria-label="{{page.image_alt}}"/>
   <view wx:if="{{imageError}}" class="image-error">插画加载失败<button class="small" catchtap="retryImage">重试插画</button></view>
   <view wx:if="{{showText && !imageError && imageReady}}" class="overlay {{bubbleReady ? 'ready' : ''}}" style="{{overlayStyle}}">
    <view class="measurements" aria-hidden="true"><view wx:for="{{measurements}}" wx:key="key" class="bubble-measure" style="width:{{item.width}}px"><view class="speaker"><text class="measure-speaker">{{item.speaker}}</text></view><view class="bubble-text"><text class="words measure-words">{{item.words}}</text></view></view></view>
    <scroll-view class="speech-scroll" scroll-y="{{overflow}}"><block wx:for="{{bubbles}}" wx:key="key"><view wx:if="{{item.tailStyle && !overflow}}" class="tail" style="{{item.tailStyle}}"/><view class="bubble" style="{{item.style}}" catchtap="keepControls"><view class="speaker">{{item.speaker}}</view><scroll-view class="bubble-text" scroll-y="{{item.scroll}}" style="{{item.scrollStyle}}"><text class="words">{{item.words}}</text></scroll-view></view></block></scroll-view>
   </view>
  </view>
  <scroll-view wx:if="{{fullscreen && narrationHeight}}" class="fullscreen-narration" scroll-y="{{true}}" style="height:{{narrationHeight}}px"><view class="narration copy">{{narration}}</view></scroll-view>
  <view wx:if="{{!fullscreen && narration}}" class="narration copy">{{narration}}</view>
  <view wx:if="{{!fullscreen || controlsVisible}}" class="player">
   <view class="player-row"><button disabled="{{index === 0}}" bindtap="previous">上一页</button><button class="primary" bindtap="play">{{playing ? '暂停' : (audioError ? '重试播放' : '播放配音')}}</button><button disabled="{{index === total - 1}}" bindtap="next">下一页</button></view>
   <view class="player-row"><picker mode="selector" range="{{pageNames}}" value="{{index}}" bindchange="pickPage"><view class="picker">第{{index + 1}} / {{total}}页 ▾</view></picker><button class="small" bindtap="auto">{{auto ? '连续播放：开' : '连续播放：关'}}</button><picker mode="selector" range="{{rates}}" value="{{rate === 1 ? 1 : (rate === 0.75 ? 0 : 2)}}" bindchange="rate"><view class="picker">{{rate}}倍 ▾</view></picker></view>
  </view>
  <button wx:if="{{fullscreen && !controlsVisible}}" class="controls-hint" bindtap="controls">第{{index + 1}} / {{total}}页 · 轻点画面显示操作{{playing ? ' · 配音中' : ''}}</button>
  <view wx:if="{{audioError}}" class="error">{{audioError}}</view>
  <button wx:if="{{index === total - 1 && !completed && !fullscreen}}" class="primary finish" bindtap="finish">我们读完啦</button>
  <view wx:if="{{completed}}" class="panel completion-panel {{celebrationEnabled ? 'celebration' : ''}}">
   <block wx:if="{{celebrationEnabled}}"><view class="completion-art"><view class="character-portrait"><image wx:if="{{completionCharacter}}" src="{{completionCharacter.image}}" mode="widthFix" style="{{completionCharacter.portraitStyle}}"/><text wx:else class="completion-book">📖</text></view><text class="completion-clap" aria-hidden="true">👏</text><text class="completion-spark" aria-hidden="true">✦</text></view><view class="completion-speaker">{{completionCharacter ? completionCharacter.name + '说' : '故事小伙伴说'}}</view><view class="completion-message"><view>谢谢你陪我</view><view>读完这个故事！</view></view><view class="completion-note">今天的故事，变成我们的小小回忆。</view></block>
   <view wx:else class="section">又读完一个好故事！</view><view class="actions"><button class="primary" bindtap="again">再读一次</button><button bindtap="shelf">返回书架</button></view></view>
 </block>
</view>
