.reader{padding:8px;min-height:100vh;background:#f8fbfc}.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.tools button{padding:8px 12px}.frame{position:relative;width:100%;background:#edf4f7;border-radius:20px;overflow:hidden;isolation:isolate}.art{position:absolute;inset:0;width:100%;height:100%}.overlay{position:absolute;visibility:hidden;pointer-events:none}.overlay.ready{visibility:visible}.speech-scroll{width:100%;height:100%;position:relative;pointer-events:auto}.bubble,.bubble-measure{position:absolute;box-sizing:border-box;max-width:calc(100% - 12px);padding:4px 7px;border:1px solid rgba(107,130,136,.2);border-radius:15px;background:rgba(255,253,244,.7);color:#294955;font-size:16px;line-height:1.5;z-index:2;overflow:hidden;text-shadow:0 1px 1px rgba(255,255,255,.7)}.speaker{font-size:12px;line-height:18px;color:#4a6b76}.measurements{position:absolute;inset:0;visibility:hidden;pointer-events:none}.bubble-text{display:block;line-height:0}.words{display:inline-block;vertical-align:top;max-width:100%;white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:24px}.tail{position:absolute;height:1px;background:rgba(99,122,129,.65);transform-origin:left center;z-index:1}.narration{font-size:18px;line-height:1.8;margin:24px 4px}.player{background:#fffdf7;padding:14px 10px;border-radius:22px;margin-top:20px}.player-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.player-row+.player-row{margin-top:14px}.player-row>button{flex:1;padding:12px 8px}.picker{font-size:14px;padding:9px 6px;white-space:nowrap}.image-error{padding:35px 20px;text-align:center}.finish{margin-top:20px}.night{background:#182b35;color:#e5eff4}.night .frame{background:#233d49}.night .player,.night .panel{background:#25414c}.expanded{padding-top:8px}.section{margin-top:0}.actions>button{min-height:56px;display:flex;align-items:center;justify-content:center}@media (min-width:700px){.reader{max-width:1100px;margin:auto}.player{max-width:650px;margin:20px auto}.player-row>button{padding:12px}.narration{max-width:800px;margin:24px auto}}@media (orientation:landscape) and (max-height:500px){.reader{padding:8px}.tools{gap:6px;margin-bottom:8px}.tools button{padding:4px 10px}.player{margin-top:8px;padding:8px}.player-row+.player-row{margin-top:6px}.narration{margin:12px 0}}
.reader-header{display:flex;align-items:center;gap:16px;margin-bottom:14px}.reader-header>view{font-size:18px;font-weight:600}.reader-header>button{flex-shrink:0}
