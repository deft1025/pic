.reader{padding:8px;min-height:100vh;background:#f8fbfc}.tools{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.languages{display:flex;gap:6px}.tools button{padding:8px 12px}.frame{position:relative;width:100%;background:#edf4f7;border-radius:20px;overflow:hidden;isolation:isolate}.art{position:absolute;inset:0;width:100%;height:100%}.overlay{position:absolute;visibility:hidden;pointer-events:none}.overlay.ready{visibility:visible}.speech-scroll{width:100%;height:100%;position:relative;pointer-events:auto}.bubble,.bubble-measure{position:absolute;box-sizing:border-box;max-width:calc(100% - 12px);padding:4px 7px;border:1px solid rgba(107,130,136,.2);border-radius:15px;background:rgba(255,253,244,.7);color:#294955;font-size:16px;line-height:1.5;z-index:2;overflow:hidden;text-shadow:0 1px 1px rgba(255,255,255,.7)}.speaker{font-size:12px;line-height:18px;color:#4a6b76}.measurements{position:absolute;inset:0;visibility:hidden;pointer-events:none}.bubble-text{display:block;line-height:0}.words{display:inline-block;vertical-align:top;max-width:100%;white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:24px}.tail{position:absolute;height:1px;background:rgba(99,122,129,.65);transform-origin:left center;z-index:1}.narration{font-size:18px;line-height:1.8;margin:24px 4px}.player{background:#fffdf7;padding:14px 10px;border-radius:22px;margin-top:20px}.player-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.player-row+.player-row{margin-top:14px}.player-row>button{flex:1;padding:12px 8px}.picker{font-size:14px;padding:9px 6px;white-space:nowrap}.image-error{padding:35px 20px;text-align:center}.finish{margin-top:20px}.section{margin-top:0}.actions>button{min-height:56px;display:flex;align-items:center;justify-content:center}@media (min-width:700px){.reader{max-width:1100px;margin:auto}.player{max-width:650px;margin:20px auto}.player-row>button{padding:12px}.narration{max-width:800px;margin:24px auto}}@media (orientation:landscape) and (max-height:500px){.reader{padding:8px}.tools{gap:6px;margin-bottom:8px}.tools button{padding:4px 10px}.player{margin-top:8px;padding:8px}.player-row+.player-row{margin-top:6px}.narration{margin:12px 0}}
.reader-header{display:flex;align-items:center;gap:16px;margin-bottom:14px}.reader-header>view{font-size:18px;font-weight:600}.reader-header>button{flex-shrink:0}

/* Immersive view owns the window; art and speech share one measured frame. */
.expanded{position:fixed;inset:0;z-index:10;width:100%;max-width:none;margin:0;padding-left:0;padding-right:0;min-height:0;background:#182b35;color:#edf4f7;display:flex;flex-direction:column;overflow:hidden}
.fullscreen-header{height:44px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:0 12px}
.expanded button{background:#294652;color:#e5eff4}.expanded button.primary{background:#ffda6e;color:#4c431d}
.expanded .frame{flex-shrink:0;border-radius:0;background:#182b35}
.expanded .art{background:transparent}
.fullscreen-narration{display:block;flex-shrink:0;min-height:0;color:#edf4f7}
.expanded .narration{font-size:17px;line-height:1.7;margin:0;padding:8px 16px;max-width:none}
.expanded .player{width:100%;max-width:none;flex-shrink:0;height:116px;border-radius:0;margin:0;padding:8px 12px;background:#182b35}
.expanded .player-row:first-child{height:44px}.expanded .player-row+.player-row{height:36px;margin-top:8px}
.expanded .player-row>button{padding:8px 6px}.expanded .player-row .small{padding:6px}
.controls-hint{height:36px;flex-shrink:0;width:100%;padding:6px 4px!important;border-radius:0;background:transparent!important;color:#b5cbd6!important;font-size:13px;line-height:24px}
.expanded>.error{position:absolute;bottom:124px;left:12px;right:12px;z-index:5}

.expanded>.panel{position:absolute;z-index:6;left:16px;right:16px;bottom:16px;background:#fffdf7;color:#264652;box-shadow:0 0 0 100vmax rgba(0,0,0,.4)}

/* Preview-only end-of-book greeting; character and portrait come from dialogue data. */
.celebration{text-align:center;padding:24px 20px;background:#fffdf4;border:1px solid #f0e7cb;border-radius:28px}
.completion-art{position:relative;width:112px;height:100px;margin:0 auto 10px;animation:character-pop .65s ease-out both}
.character-portrait{position:absolute;left:10px;top:4px;width:88px;height:88px;border-radius:50%;overflow:hidden;background:#e5f2f2;border:4px solid #fff}
.character-portrait image{position:absolute;width:200%;height:auto;background:transparent}.completion-book{font-size:48px;line-height:80px}
.completion-clap{position:absolute;right:-2px;bottom:0;font-size:32px;transform-origin:50% 80%;animation:little-applause .3s ease-in-out 4 alternate}
.completion-spark{position:absolute;left:-2px;top:6px;color:#e8ad38;font-size:24px}
.completion-speaker{font-size:15px;color:#719088;margin-bottom:6px}.completion-message{font-size:24px;font-weight:700;line-height:1.5;color:#365c61}.completion-note{font-size:13px;color:#8b9892;margin-top:12px}
.celebration .actions{margin-bottom:0}.expanded>.completion-panel{max-height:calc(100% - 32px);overflow-y:auto}.expanded .celebration .actions>button:not(.primary){background:#eaf4fa;color:#285970}
@keyframes character-pop{0%{transform:translateY(16px) scale(.88);opacity:0}65%{transform:translateY(-5px) scale(1.03);opacity:1}100%{transform:translateY(0) scale(1);opacity:1}}
@keyframes little-applause{from{transform:rotate(-12deg)}to{transform:rotate(12deg)}}
