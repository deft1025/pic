.reader{padding:8px;min-height:100vh;background:#f8fbfc}.tools{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.languages{display:flex;gap:6px}.tools button{padding:8px 12px}.frame{position:relative;width:100%;background:#edf4f7;border-radius:20px;overflow:hidden;isolation:isolate}.art{position:absolute;inset:0;width:100%;height:100%}.overlay{position:absolute;visibility:hidden;pointer-events:none}.overlay.ready{visibility:visible}.speech-scroll{width:100%;height:100%;position:relative;pointer-events:auto}.bubble,.bubble-measure{position:absolute;box-sizing:border-box;max-width:calc(100% - 12px);padding:4px 7px;border:1px solid rgba(107,130,136,.2);border-radius:15px;background:rgba(255,253,244,.7);color:#294955;font-size:16px;line-height:1.5;z-index:2;overflow:hidden;text-shadow:0 1px 1px rgba(255,255,255,.7)}.speaker{font-size:12px;line-height:18px;color:#4a6b76}.measurements{position:absolute;inset:0;visibility:hidden;pointer-events:none}.bubble-text{display:block;line-height:0}.words{display:inline-block;vertical-align:top;max-width:100%;white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:24px}.tail{position:absolute;height:1px;background:rgba(99,122,129,.65);transform-origin:left center;z-index:1}.narration{font-size:18px;line-height:1.8;margin:24px 4px}.player{background:#fffdf7;padding:14px 10px;border-radius:22px;margin-top:20px}.player-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.player-row+.player-row{margin-top:14px}.player-row>button{flex:1;padding:12px 8px}.picker{font-size:14px;padding:9px 6px;white-space:nowrap}.image-error{padding:35px 20px;text-align:center}.finish{margin-top:20px}.section{margin-top:0}.actions>button{min-height:56px;display:flex;align-items:center;justify-content:center}@media (min-width:700px){.reader{max-width:1100px;margin:auto}.player{max-width:650px;margin:20px auto}.player-row>button{padding:12px}.narration{max-width:800px;margin:24px auto}}@media (orientation:landscape) and (max-height:500px){.reader{padding:8px}.tools{gap:6px;margin-bottom:8px}.tools button{padding:4px 10px}.player{margin-top:8px;padding:8px}.player-row+.player-row{margin-top:6px}.narration{margin:12px 0}}
.reader-header{display:flex;align-items:center;gap:16px;margin-bottom:14px}.reader-header>view{font-size:18px;font-weight:600}.reader-header>button{flex-shrink:0}

/* Immersive view owns the window; art and speech share one measured frame. */
.expanded{position:fixed;inset:0;z-index:10;width:100%;max-width:none;margin:0;padding-left:0;padding-right:0;min-height:0;background:#182b35;color:#edf4f7;display:flex;flex-direction:column;overflow:hidden}
.fullscreen-header{height:44px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:0 12px}
.expanded button{background:#294652;color:#e5eff4}.expanded button.primary{background:#ffda6e;color:#4c431d}
.expanded .frame{flex-shrink:0;border-radius:0;background:#182b35}
.expanded .art{background:transparent}
.fullscreen-narration{display:block;flex-shrink:0;min-height:0;color:#edf4f7}
.expanded .narration{font-size:17px;line-height:1.7;margin:0;padding:8px 16px;max-width:none}
.fullscreen-pages{display:flex;align-items:center;justify-content:center;gap:12px;height:48px;flex-shrink:0;padding:4px 12px;box-sizing:border-box}.fullscreen-pages button{flex:1;max-width:120px;min-width:40px;height:40px;padding:4px 6px;font-size:26px;line-height:32px}.fullscreen-pages text{flex-shrink:0;font-size:12px;color:#b5cbd6}.controls-hint{height:48px;flex-shrink:0;width:100%;padding:12px 4px!important;border-radius:0;background:transparent!important;color:#b5cbd6!important;font-size:12px;line-height:24px}
.expanded>.error{position:absolute;bottom:56px;left:12px;right:12px;z-index:5}
.expanded>.panel{position:absolute;z-index:6;left:16px;right:16px;bottom:16px;background:#fffdf7;color:#264652;box-shadow:0 0 0 100vmax rgba(0,0,0,.4)}

/* Fit the illustration's aspect ratio first, with a compact narration column. */
.expanded.landscape{display:grid;grid-template-columns:minmax(0,1fr) minmax(144px,1fr);grid-template-rows:44px minmax(0,1fr) 48px;column-gap:12px;align-content:stretch}
.expanded.landscape .frame{grid-column:1;grid-row:1 / 4;align-self:center;min-width:0}
.expanded.landscape .fullscreen-header{grid-column:2;grid-row:1;padding:0;gap:4px;justify-content:flex-end}.expanded.landscape .fullscreen-header button{font-size:13px;padding:6px 8px;white-space:nowrap}
.expanded.landscape .fullscreen-narration{grid-column:2;grid-row:2;min-width:0}.expanded.landscape .narration{padding:4px;font-size:17px}
.expanded.landscape .fullscreen-pages,.expanded.landscape .controls-hint{grid-column:2;grid-row:3;min-width:0;padding:4px 0;gap:6px}.expanded.landscape .fullscreen-pages button{padding:4px 2px}.expanded.landscape .controls-hint{font-size:12px;white-space:normal;line-height:18px;padding:6px 2px!important}

/* End-of-book greeting; character and portrait come from dialogue data. */
.celebration{text-align:center;padding:24px 20px;background:#fffdf4;border:1px solid #f0e7cb;border-radius:28px}
.completion-panel.celebration{position:fixed;z-index:20;top:50%;bottom:auto;left:16px;right:16px;transform:translateY(-50%);width:calc(100% - 32px);max-width:400px;max-height:calc(100% - 32px);margin:0 auto;overflow-y:auto;color:#264652;box-shadow:0 0 0 100vmax rgba(0,0,0,.4)}
.celebration .completion-art{position:relative;display:block;width:190px;height:176px;padding:0;margin:0 auto 8px;background:transparent;border-radius:24px;overflow:visible;animation:character-pop .8s ease-out both}
.character-portrait{position:absolute;left:23px;top:9px;width:144px;height:144px;border-radius:50%;overflow:hidden;background:#e5f2f2;border:5px solid #fff;transform-origin:50% 85%;animation:friend-greet 2s ease-in-out .8s 3}
.character-portrait image{position:absolute;width:200%;height:auto;background:transparent}.completion-book{font-size:72px;line-height:134px}
.completion-clap{position:absolute;right:0;bottom:10px;font-size:44px;line-height:1.2;transform-origin:50% 80%;animation:little-applause 1.1s ease-in-out .5s 6}
.completion-spark{position:absolute;left:4px;top:30px;color:#e8ad38;font-size:27px;line-height:1;animation:star-sparkle 1.6s ease-in-out .8s 4}.spark-right{left:auto;right:0;top:3px;font-size:20px;animation-delay:1.2s}
.completion-speaker{font-size:14px;color:#719088;margin-bottom:6px}.completion-message{font-size:18px;font-weight:600;line-height:1.65;color:#365c61}.completion-note{font-size:12px;color:#8b9892;margin-top:12px}
.celebration .actions{margin-top:20px;margin-bottom:0}.celebration .actions>button{min-height:48px;font-size:15px;padding:12px 8px}.expanded>.completion-panel{max-height:calc(100% - 32px);overflow-y:auto}.expanded .celebration .actions>button:not(.primary){background:#eaf4fa;color:#285970}
.character-reply .character-portrait{animation:character-highfive .7s ease-out both}.character-reply .completion-clap{animation:hand-highfive .7s ease-out both}.completion-heart{position:absolute;left:85px;top:50px;color:#e3967d;font-size:28px;line-height:1;pointer-events:none;animation:heart-reply 1.4s ease-out both}
@keyframes character-pop{0%{transform:translateY(28px) scale(.75);opacity:0}60%{transform:translateY(-9px) scale(1.06);opacity:1}80%{transform:translateY(3px) scale(.98)}100%{transform:translateY(0) scale(1);opacity:1}}
@keyframes friend-greet{0%,100%{transform:translateY(0) rotate(0)}22%{transform:translateY(-8px) rotate(-6deg)}48%{transform:translateY(-2px) rotate(5deg)}72%{transform:translateY(-6px) rotate(-3deg)}}
@keyframes little-applause{0%,100%{transform:rotate(-14deg) scale(1)}25%,65%{transform:rotate(12deg) scale(1.2)}45%,85%{transform:rotate(-8deg) scale(1.05)}}
@keyframes star-sparkle{0%,100%{transform:scale(.8);opacity:.5}50%{transform:scale(1.2) rotate(12deg);opacity:1}}
@keyframes character-highfive{0%,100%{transform:translateY(0) rotate(0)}35%{transform:translateY(-16px) rotate(8deg) scale(1.08)}65%{transform:translateY(-5px) rotate(-4deg)}}
@keyframes hand-highfive{0%{transform:translate(0,0) rotate(-15deg)}40%{transform:translate(-24px,-38px) rotate(8deg) scale(1.3)}70%{transform:translate(-18px,-26px) rotate(-5deg) scale(1.15)}100%{transform:translate(-8px,-12px) rotate(0)}}
@keyframes heart-reply{0%{transform:translateY(0) scale(.5);opacity:0}25%{opacity:1}100%{transform:translateY(-65px) scale(1.2);opacity:0}}
@media (orientation:landscape) and (max-height:500px){.completion-panel.celebration{max-width:580px;display:grid;grid-template-columns:160px minmax(0,1fr);column-gap:18px;padding:18px}.celebration .completion-art{grid-column:1;grid-row:1 / span 4;width:160px;height:176px;margin:0;align-self:center}.celebration .character-portrait{left:8px}.celebration .completion-speaker,.celebration .completion-message,.celebration .completion-note,.celebration .actions{grid-column:2}.celebration .completion-note{margin-top:6px}.celebration .actions{margin:14px 0 0}}
