.age-mask{position:fixed;inset:0;z-index:1000;background:rgba(44,79,96,.22);display:flex;align-items:center;justify-content:center;padding:20px 24px}.age-welcome{width:100%;max-width:420px;max-height:calc(100vh - 40px);overflow-y:auto;padding:24px;border-radius:32px;background:#fffef9;border:1px solid rgba(255,255,255,.8);text-align:center}.welcome-art{height:70px;width:120px;margin:0 auto 12px;position:relative}.little-book{position:absolute;width:49px;height:58px;border-radius:8px 12px 12px 8px;border-left:5px solid rgba(255,255,255,.5)}.book-back{left:27px;top:6px;background:#c5e6ee;transform:rotate(-14deg)}.book-front{left:48px;top:10px;background:#ffe19a;transform:rotate(10deg);padding:18px 8px}.book-line{height:3px;background:#fff9e8;border-radius:5px;margin-bottom:7px}.book-line.short{width:65%}.little-sun{position:absolute;right:9px;top:0;width:15px;height:15px;border-radius:50%;background:#ffd474}.little-dot{position:absolute;left:9px;bottom:10px;width:8px;height:8px;border-radius:50%;background:#b4d9ce}.welcome-kicker{font-size:13px;color:#719098;letter-spacing:1px}.welcome-title{font-size:25px;font-weight:700;line-height:1.4;margin:8px 0;color:#335e6c}.welcome-copy{font-size:15px;line-height:1.7;color:#6e858b;margin-bottom:18px}.age-options{height:282px;max-height:40vh;text-align:left}.age-option{display:flex;gap:14px;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:20px;background:#edf7fc;border:2px solid transparent;margin-bottom:10px;min-height:76px}.age-option:nth-child(2){background:#fff6df}.age-option:nth-child(3){background:#edf7f1}.age-option.selected{border-color:#7bb5c4}.age-option-copy{flex:1;min-width:0}.age-option-title{font-size:18px;font-weight:600;color:#365f6c}.age-option-desc{font-size:13px;line-height:1.5;color:#789096;margin-top:3px;white-space:normal}.age-check{width:24px;height:24px;flex-shrink:0;border-radius:50%;background:rgba(255,255,255,.8);border:1px solid #c6dce2;display:flex;align-items:center;justify-content:center;color:#468e9e;font-size:16px}.selected .age-check{background:#e0f0ee;border-color:#7bb5c4}.welcome-save{margin-top:12px;padding:13px 18px;min-height:50px}.welcome-note{font-size:12px;color:#91a2a6;margin-top:12px}@media(max-height:600px){.age-welcome{padding:18px 20px;border-radius:26px}.welcome-art{height:50px;transform:scale(.75);transform-origin:top center;margin-bottom:0}.welcome-copy{margin-bottom:12px}.age-options{height:240px;max-height:35vh}.welcome-title{font-size:23px}}
