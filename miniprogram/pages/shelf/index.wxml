<view class="page"><view class="hero"><view class="title">{{loggedIn ? (profile.name || '我的小书架') : '我的小书架'}}</view><view class="subtitle">{{loggedIn ? '喜欢的故事，都收在这里。' : '故事可以直接读，登录后收藏喜欢的绘本。'}}</view><view wx:if="{{loggedIn}}" class="note">用户编号 {{profile.id}}</view><view class="actions"><button wx:if="{{!loggedIn}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">微信登录</button><block wx:else><button class="primary" bindtap="profile">{{needsProfile ? '选择年龄段' : '修改资料'}}</button><button disabled="{{busy}}" bindtap="logout">退出登录</button></block></view><view wx:if="{{needsProfile}}" class="note">先选好年龄段，再把喜欢的故事加入收藏。</view><view class="link" bindtap="about">关于我们与隐私说明</view></view><view wx:if="{{loginError}}" class="error" role="alert">{{loginError}}</view><view wx:if="{{syncError}}" class="error">同步未完成：{{syncError}}<button bindtap="load">重试同步</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><view wx:if="{{loading}}" class="empty">正在整理书架…</view><view class="section">喜欢的绘本</view><view class="grid"><book-card wx:for="{{items}}" wx:key="id" book="{{item}}"/></view><view wx:if="{{!items.length && !loading}}" class="empty">{{loggedIn ? '遇到喜欢的故事，就点一下收藏吧。' : '登录后可以收藏喜欢的绘本。'}}</view><view wx:if="{{ageDialog}}" class="age-mask" catchtouchmove="keepDialog"><view class="age-welcome" role="dialog" aria-label="选择阅读年龄段"><view class="welcome-art" aria-hidden="true"><view class="little-book book-back"/><view class="little-book book-front"><view class="book-line"/><view class="book-line short"/></view><view class="little-sun"/><view class="little-dot"/></view><view class="welcome-kicker">初次见面，很高兴认识你</view><view class="welcome-title">小读者，几岁啦？</view><view class="welcome-copy">选一个适合的年龄段，<br/>让故事陪着孩子慢慢长大。</view><scroll-view class="age-options" scroll-y><view wx:for="{{firstAges}}" wx:key="id" class="age-option {{firstAge === item.id ? 'selected' : ''}}" data-age="{{item.id}}" bindtap="selectFirstAge" role="button" aria-label="{{item.name}}"><view class="age-option-copy"><view class="age-option-title">{{item.name}}</view><view class="age-option-desc">{{item.description}}</view></view><view class="age-check">{{firstAge === item.id ? '✓' : ''}}</view></view></scroll-view><button class="primary welcome-save" loading="{{ageSaving}}" disabled="{{!firstAge || ageSaving}}" bindtap="saveFirstAge">选好啦，开始读故事</button><view class="welcome-note">以后也可以在个人资料里修改</view></view></view></view>
