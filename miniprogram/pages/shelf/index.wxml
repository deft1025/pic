<view class="page tab-page shelf-page">
 <view class="account-card">
  <view class="account-top">
   <view class="account-heading">
    <view class="account-avatar-wrap"><image wx:if="{{avatar && !avatarError}}" class="account-avatar" src="{{avatar}}" mode="aspectFill" binderror="avatarFailed" aria-label="阅读头像"/><text wx:else class="account-avatar-fallback" aria-hidden="true">📖</text></view>
    <view class="account-copy"><view class="account-name">{{loggedIn ? (profile.name || '小小读者') : '我的小书架'}}</view><view class="account-age">{{loggedIn ? ageLabel : '每一天，和好故事见面'}}</view></view>
   </view>
   <button wx:if="{{loggedIn}}" class="account-edit" bindtap="profile">{{needsProfile ? '选年龄段' : '修改资料'}}<text aria-hidden="true"> ›</text></button>
  </view>
  <view class="account-description">{{loggedIn ? '喜欢的故事，都收在这里。' : '故事可以直接读，登录后收藏喜欢的绘本。'}}</view>
  <button wx:if="{{!loggedIn}}" class="primary account-login" loading="{{busy}}" disabled="{{busy}}" bindtap="login">微信登录</button>
  <view wx:if="{{needsProfile}}" class="account-hint">先选好年龄段，再把喜欢的故事加入收藏。</view>
  <view class="account-footer"><button class="account-link" bindtap="about">关于我们与隐私说明</button><button wx:if="{{loggedIn}}" class="account-link account-logout" disabled="{{busy}}" bindtap="logout">退出登录</button></view>
 </view>
 <view wx:if="{{loginError}}" class="error" role="alert">{{loginError}}</view><view wx:if="{{syncError}}" class="error">同步未完成：{{syncError}}<button bindtap="load">重试同步</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><view wx:if="{{loading}}" class="empty">正在整理书架…</view><view class="shelf-heading"><view class="section">喜欢的绘本</view><text wx:if="{{total}}" class="note">{{total}}本</text></view><view class="favorite-list"><view wx:for="{{items}}" wx:key="id" class="favorite-row" data-id="{{item.id}}" bindtap="openBook" role="button" aria-label="查看{{item.title_zh}}"><image class="favorite-cover" src="{{item.cover}}" mode="aspectFit" lazy-load/><view class="favorite-title">{{item.title_zh}}</view><text wx:if="{{item.completed}}" class="favorite-completion" aria-label="已读完">✓ 已读完</text><text class="favorite-arrow" aria-hidden="true">›</text></view></view><view wx:if="{{pageCount > 1}}" class="shelf-pagination"><button class="small" bindtap="previous" disabled="{{loading || page <= 1}}">上一页</button><text class="note">{{page}} / {{pageCount}}</text><button class="small" bindtap="next" disabled="{{loading || page >= pageCount}}">下一页</button></view><view wx:if="{{!items.length && !loading}}" class="empty">{{loggedIn ? '遇到喜欢的故事，就点一下收藏吧。' : '登录后可以收藏喜欢的绘本。'}}</view><view wx:if="{{ageDialog}}" class="age-mask" catchtouchmove="keepDialog"><view class="age-welcome" role="dialog" aria-label="选择阅读年龄段"><view class="welcome-art" aria-hidden="true"><view class="little-book book-back"/><view class="little-book book-front"><view class="book-line"/><view class="book-line short"/></view><view class="little-sun"/><view class="little-dot"/></view><view class="welcome-kicker">初次见面，很高兴认识你</view><view class="welcome-title">小读者，几岁啦？</view><view class="welcome-copy">选一个适合的年龄段，<br/>让故事陪着孩子慢慢长大。</view><scroll-view class="age-options" scroll-y><view wx:for="{{firstAges}}" wx:key="id" class="age-option {{firstAge === item.id ? 'selected' : ''}}" data-age="{{item.id}}" bindtap="selectFirstAge" role="button" aria-label="{{item.name}}"><view class="age-option-copy"><view class="age-option-title">{{item.name}}</view><view class="age-option-desc">{{item.description}}</view></view><view class="age-check">{{firstAge === item.id ? '✓' : ''}}</view></view></scroll-view><button class="primary welcome-save" loading="{{ageSaving}}" disabled="{{!firstAge || ageSaving}}" bindtap="saveFirstAge">选好啦，开始读故事</button><view class="welcome-note">以后也可以在个人资料里修改</view></view></view></view>
