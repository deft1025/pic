  "narration_additions": [],
  "pages": [
    {
      "page_number": 1,
      "text_original": "I wonder if there’s another me somewhere in the world.",
      "original_was_wordless": false
    },
    {
      "page_number": 2,
      "text_original": "Who looks the same. And talks the same.",
      "original_was_wordless": false
    },
    {
      "page_number": 3,
      "text_original": "And even has my curls.",
      "original_was_wordless": false
    },
    {
      "page_number": 4,
      "text_original": "Someone with my eyes my ears. Who even has my laugh.",
      "original_was_wordless": false
    },
    {
      "page_number": 5,
      "text_original": "Who can do what I can do …",
      "original_was_wordless": false
    },
    {
      "page_number": 6,
      "text_original": "… and can’t do what I can’t.",
      "original_was_wordless": false
    },
    {
      "page_number": 7,
      "text_original": "I’ve looked and looked everywhere to find another me. I went down to the park and looked behind the trees.",
      "original_was_wordless": false
    },
    {
      "page_number": 8,
      "text_original": "I looked around, up and down …",
      "original_was_wordless": false
    },
    {
      "page_number": 9,
      "text_original": "… at every single face.",
      "original_was_wordless": false
    },
    {
      "page_number": 10,
      "text_original": "I couldn’t find another me in any single place.",
      "original_was_wordless": false
    },
    {
      "page_number": 11,
      "text_original": "There’s only one me in the world! I’m special, oh it’s true!",
      "original_was_wordless": false
    },
    {
      "page_number": 12,
      "text_original": "But not just me, don’t you see? There’s only one of you!",
      "original_was_wordless": false
    }
  ]
}
