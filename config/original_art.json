  "bd-little-goat": {
    "pages": {
      "1": {
        "text_regions": [
          {
            "text": "The sky was blue above.",
            "box": [
              0.6314118084423447,
              0.17199329606440972,
              0.2385984078280804,
              0.05458149332596851
            ]
          },
          {
            "text": "But she did not look up.",
            "box": [
              0.6346320512731815,
              0.2266891336219753,
              0.22860001398214735,
              0.056167599174334004
            ]
          },
          {
            "text": "Little Goat went to find the",
            "box": [
              0.11604909315721636,
              0.41925580242748106,
              0.2690735757456317,
              0.05109156545042737
            ]
          },
          {
            "text": "sweetest grass.",
            "box": [
              0.17467837294992875,
              0.48041607174211787,
              0.14764037707978808,
              0.054307400738087264
            ]
          }
        ]
      },
      "2": {
        "text_regions": [
          {
            "text": "The river gurgled below.",
            "box": [
              0.6312794688000798,
              0.30227724170671666,
              0.23874915058844204,
              0.059662217257740235
            ]
          },
          {
            "text": "But Little Goat did not listen to its song.",
            "box": [
              0.5544333077847473,
              0.3502880185882491,
              0.39128375973284646,
              0.06901592964225944
            ]
          }
        ]
      },
      "3": {
        "text_regions": [
          {
            "text": "But Little Goat didn't answer.",
            "box": [
              0.5512655327395014,
              0.18319170419403064,
              0.2891231828125995,
              0.04919206450661673
            ]
          },
          {
            "text": "A bird called to her, saying,",
            "box": [
              0.05080173257773487,
              0.8012570163925236,
              0.27176702790057305,
              0.05613925155134081
            ]
          },
          {
            "text": "\"How do you do?\"",
            "box": [
              0.05178416022884349,
              0.8567708333333334,
              0.1810269798059694,
              0.05729166661220042
            ]
          }
        ]
      },
      "4": {
        "text_regions": [
          {
            "text": "She just walked along looking for the",
            "box": [
              0.5677736575371042,
              0.44402862279806443,
              0.3648942066043741,
              0.06375848607196155
            ]
          },
          {
            "text": "sweetest grass.",
            "box": [
              0.6740711449859144,
              0.5064761225682299,
              0.14796867253777823,
              0.05883775975523253
            ]
          }
        ]
      },
      "5": {
        "text_regions": [
          {
            "text": "As she walked along, Little Goat",
            "box": [
              0.5486482835902626,
              0.2972543106409863,
              0.32733527606131463,
              0.0629969593034857
            ]
          },
          {
            "text": "moved further and further away",
            "box": [
              0.5475960134661509,
              0.35159901695174556,
              0.3200106785237494,
              0.06050208565580151
            ]
          },
          {
            "text": "from Mother Goat.",
            "box": [
              0.5478677111151126,
              0.4140625,
              0.1906005219751309,
              0.045138888839000524
            ]
          }
        ]
      },
      "6": {
        "text_regions": [
          {
            "text": "Little Goat found the sweetest grass.",
            "box": [
              0.07153344764320607,
              0.09499223245111232,
              0.35823870217170406,
              0.059995350295050986
            ]
          },
          {
            "text": "She ate and ate.",
            "box": [
              0.16579634464751958,
              0.15885416666666663,
              0.16710182755999436,
              0.04340277774864032
            ]
          },
          {
            "text": "She had walked far from Mother Goat.",
            "box": [
              0.5539599651871192,
              0.6744791666666666,
              0.3899042641849304,
              0.04687499995440525
            ]
          }
        ]
      },
      "7": {
        "text_regions": [
          {
            "text": "Mother Goat wondered where",
            "box": [
              0.09878154929173794,
              0.4071180555555556,
              0.3037423844212359,
              0.04687499996108713
            ]
          },
          {
            "text": "Little Goat had",
            "box": [
              0.14316797219069405,
              0.4644097222222222,
              0.15578764129929729,
              0.045138888853018866
            ]
          },
          {
            "text": "gone.",
            "box": [
              0.30112124609884955,
              0.47236294216579866,
              0.05742027076873912,
              0.043463389078776005
            ]
          },
          {
            "text": "She looked in the mealie patch, but",
            "box": [
              0.5764861375061003,
              0.8001354401218816,
              0.3535347464050944,
              0.055728959028253144
            ]
          },
          {
            "text": "Little Goat was not there.",
            "box": [
              0.6279373368146214,
              0.8602430555555556,
              0.2523933853561521,
              0.041666666635470806
            ]
          }
        ]
      },
      "8": {
        "text_regions": [
          {
            "text": "Mother Goat ran to the river.",
            "box": [
              0.619234118046127,
              0.2126736111545139,
              0.28546562085726723,
              0.04513888867187499
            ]
          },
          {
            "text": "But Little Goat was not there.",
            "box": [
              0.6192341166231505,
              0.2699652777777778,
              0.2872062662315056,
              0.045138888875696614
            ]
          },
          {
            "text": "\"Where are",
            "box": [
              0.6218450826805918,
              0.3828125,
              0.11227154033891362,
              0.043402777728758224
            ]
          },
          {
            "text": "you, Little Goat,\"",
            "box": [
              0.7366351547607051,
              0.3788145884920311,
              0.16981332008380923,
              0.0578294395553256
            ]
          },
          {
            "text": "bleated Mother Goat.",
            "box": [
              0.6512092349875452,
              0.43497937620811244,
              0.2206382747879705,
              0.051454373668461506
            ]
          }
        ]
      },
      "9": {
        "text_regions": [
          {
            "text": "A bird called to Mother Goat.",
            "box": [
              0.602697998259356,
              0.11892361111111116,
              0.29416884236308527,
              0.0451388888728137
            ]
          },
          {
            "text": "\"Little Goat is asleep in the sweet grass",
            "box": [
              0.5591818973020017,
              0.1762152777777778,
              0.383812010356832,
              0.052083333321890746
            ]
          },
          {
            "text": "across the bridge.\"",
            "box": [
              0.6592689295559987,
              0.23177083333333337,
              0.17754569176689083,
              0.05208333329368975
            ]
          }
        ]
      },
      "10": {
        "text_regions": [
          {
            "text": "Mother Goat crossed the bridge,",
            "box": [
              0.5870322019147084,
              0.45052083333333326,
              0.32637075709312446,
              0.05381944443051845
            ]
          },
          {
            "text": "to the sweet grass.",
            "box": [
              0.6578965770107993,
              0.5045687595355336,
              0.18299934061249523,
              0.056840202820629404
            ]
          }
        ]
      },
      "11": {
        "text_regions": [
          {
            "text": "There she found Little Goat",
            "box": [
              0.04917142777918999,
              0.30942148888803134,
              0.2742385763419092,
              0.05083133279571972
            ]
          },
          {
            "text": "fast asleep.",
            "box": [
              0.048302872062663184,
              0.3706597222222222,
              0.11314186240208879,
              0.05208333329430459
            ]
          }
        ]
      },
      "12": {
        "text_regions": [
          {
            "text": "\"Wake",
            "box": [
              0.05057371918069891,
              0.09931952423519563,
              0.0641071694741776,
              0.04305994510650635
            ]
          },
          {
            "text": "up, Little Goat,\" said",
            "box": [
              0.12045964233026868,
              0.09603172656653103,
              0.20548219873723905,
              0.05588819765913522
            ]
          },
          {
            "text": "Mother Goat gently. \"You were lost!\"",
            "box": [
              0.04830287206287547,
              0.15364583333333337,
              0.35857267180135427,
              0.05555555554242886
            ]
          },
          {
            "text": "\"I wasn't lost... I have been here all the",
            "box": [
              0.5513489991296779,
              0.8012152777777778,
              0.3759791121845082,
              0.04513888887881856
            ]
          },
          {
            "text": "time!\" said Little Goat.",
            "box": [
              0.5478677110530896,
              0.8585069444444444,
              0.22541340283901845,
              0.04340277775549617
            ]
          }
        ]
      }
    }
  },
